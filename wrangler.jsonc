{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Shared configuration for local development, tests, and deploys. It holds no
  // production values: the host, D1 database ID, bot username, and contact address
  // live in the untracked wrangler.production.local.json, which `npm run deploy`
  // merges in (scripts/production-config.mjs). Deploy only through that script; a
  // plain `wrangler deploy` with this file fails on the placeholder database ID.
  "name": "oh-my-days",
  "main": "src/worker.ts",
  // Minified: each fresh isolate parses the whole bundle, and that startup counts
  // toward the 10 ms CPU limit of every cron run (docs/capacity.md). Source maps
  // are uploaded so errors still point at the TypeScript.
  "minify": true,
  "upload_source_maps": true,
  // Bundles the Mini App client into src/miniapp/generated (ADR 0005) and builds
  // the landing page into landing/dist before each build (ADR 0006).
  "build": { "command": "npm run build:app && npm run build:landing" },
  // The landing page at /, served as static assets before the Worker runs; every
  // other path (/privacy, /connect, /oauth/*, /app, /telegram/webhook, /healthz)
  // has no asset and reaches the Worker unchanged (ADR 0006).
  "assets": { "directory": "./landing/dist", "html_handling": "auto-trailing-slash" },
  // Must not exceed the workerd version bundled with @cloudflare/vitest-pool-workers.
  "compatibility_date": "2026-08-15",
  "observability": { "enabled": true },
  // Served only from a custom domain (ADR 0002), set in the production file; no workers.dev hostname.
  "workers_dev": false,
  // Non-secret settings. Local development sets PUBLIC_BASE_URL, TELEGRAM_BOT_USERNAME,
  // and CONTACT_EMAIL in .dev.vars; production sets them in the production file.
  "vars": {
    // Google access lasts 7 days while the OAuth app is in Testing; remove once verified.
    "TESTING_TOKEN_TTL_DAYS": "7"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "oh-my-days",
      // Placeholder. Local development and tests use a local copy keyed by this ID
      // and never touch a remote database; the real ID is in the production file.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  // One scheduled handler per the shared-account cron budget.
  "triggers": { "crons": ["* * * * *"] }
  // Secrets (never committed): see .dev.vars.example.
}
