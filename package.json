{
  "name": "oh-my-days",
  "version": "2.0.0-beta.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "wrangler dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "npm run lint && npm run typecheck && npm test",
    "db:migrate:local": "wrangler d1 migrations apply oh-my-days --local"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "@cloudflare/workers-types": "5.20260926.1",
    "typescript": "7.0.2",
    "vitest": "4.1.11",
    "wrangler": "4.141.0"
  },
  "overrides": {
    "sharp": "0.35.4"
  }
}
